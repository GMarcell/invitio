// Invitio — Online Invitation Maker
// PostgreSQL via Docker (see docker-compose.yml)

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────── Auth (NextAuth) ───────────────────────────

model User {
  id        String   @id @default(uuid())
  name      String?
  email     String   @unique
  password  String? // null for OAuth-only accounts
  image     String?
  createdAt DateTime @default(now())

  invitations  Invitation[]       @relation("InvitationOwner")
  collaborators Collaborator[]
  accounts     Account[]
  sessions     Session[]

  @@index([email])
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────── Rate limiting ───────────────────────────
// DB-backed sliding-window counters keyed by "scope:identifier" (e.g.
// "login:1.2.3.4"). Used for login/RSVP/guestbook/photo-upload throttling;
// a DB table (rather than in-memory) survives restarts and works across
// instances. Stale rows are pruned periodically.

model RateLimit {
  id          String   @id @default(uuid())
  key         String   @unique // e.g. "login:<ip>", "rsvp:<invitationId>:<ip>"
  windowStart DateTime // start of the current counting window
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@index([windowStart])
}

// ─────────────────────────── Templates ───────────────────────────

model Template {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  category    String // wedding | birthday | baby_shower | corporate | holiday | generic
  description String
  emoji       String? // preview icon
  gradient    String? // preview gradient css
  isPremium   Boolean  @default(false)
  isPublished Boolean  @default(true)
  theme       Json // default { colors: {...}, fonts: {...} }
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  invitations Invitation[]
}

// ─────────────────────────── Invitation / Event ───────────────────────────

model Invitation {
  id              String   @id @default(uuid())
  slug            String   @unique
  title           String
  subtitle        String?
  description     String?
  category        String   @default("generic")
  eventDate       DateTime?
  timezone        String   @default("Asia/Jakarta")
  location        String?
  locationLink    String?
  dressCode       String?
  rsvpDeadline    DateTime?
  coverImage      String? // gradient or image key
  customQuestions Json? // [{ id, label, required }]
  mealOptions     Json? // ["Chicken","Fish",...] — shown when hasMealOption
  hasMealOption   Boolean  @default(false)
  accessCode      String? // optional password for private invitations
  defaultLanguage String   @default("en") // en | id

  status String @default("draft") // draft | active | past

  // theme overrides { colors: {primary, secondary, accent, bg, text}, fonts: {heading, body} }
  theme Json?

  // section toggles
  showCountdown Boolean @default(true)
  showCalendar  Boolean @default(true)
  showGuestbook Boolean @default(true)
  showGift      Boolean @default(false)

  // automated RSVP reminders (cron-driven)
  enableReminders    Boolean @default(false)
  reminderOffsetDays Int     @default(7) // send reminder this many days before the RSVP deadline

  // photo gallery toggles
  showGallery       Boolean @default(false) // show the gallery section on the invitation page
  allowGuestPhotos  Boolean @default(false) // guests can upload photos to the gallery

  templateId String?
  template   Template? @relation(fields: [templateId], references: [id])

  ownerId String
  owner   User   @relation("InvitationOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rsvps         Rsvp[]
  guests        Guest[]
  messages      GuestbookMessage[]
  giftAccounts  GiftAccount[]
  gifts         Gift[]
  collaborators Collaborator[]
  photos        Photo[]

  @@index([ownerId])
  @@index([status])
  @@index([templateId])
}

// ─────────────────────────── Photo gallery ───────────────────────────

model Photo {
  id           String   @id @default(uuid())
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  uploadedBy   String   @default("host") // host | guest
  guestName    String? // name of the guest who uploaded (when uploadedBy = "guest")
  caption      String?
  objectKey    String   @unique // storage key (R2 bucket or local .local/uploads)
  thumbObjectKey String? @unique // generated WebP thumbnail (kept smaller for fast mobile loading)
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())

  @@index([invitationId])
  @@index([createdAt])
}

// ─────────────────────────── Invited guests list ───────────────────────────
// The host's guest list (manually added or CSV-imported). An invited guest is
// "pending" until their RSVP is linked to them.

model Guest {
  id           String   @id @default(uuid())
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  name         String
  email        String?
  phone        String?
  source       String   @default("manual") // manual | import
  rsvpId       String?  @unique
  rsvp         Rsvp?    @relation(fields: [rsvpId], references: [id])
  reminderSentAt DateTime? // set once a reminder email has been sent (prevents re-sending)
  createdAt    DateTime @default(now())

  @@index([invitationId])
}

// ─────────────────────────── RSVP / Guests ───────────────────────────

model Rsvp {
  id            String   @id @default(uuid())
  invitationId  String
  invitation    Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  name          String
  email         String?
  phone         String?
  status        String // yes | no | maybe
  guestCount    Int      @default(1)
  mealChoice    String?
  answers       Json? // answers to custom questions { questionLabel: answer }
  note          String?
  guest         Guest?
  createdAt     DateTime @default(now())

  @@index([invitationId])
  @@index([status])
}

model GuestbookMessage {
  id           String   @id @default(uuid())
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  name         String
  message      String
  createdAt    DateTime @default(now())

  @@index([invitationId])
}

// ─────────────────────────── Gifts ───────────────────────────

model GiftAccount {
  id            String   @id @default(uuid())
  invitationId  String
  invitation    Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  label         String // e.g. "Bride", "Groom", "E-Wallet"
  accountHolder String
  bankName      String?
  accountNumber String
  qrImage       String? // optional QR code image URL for e-wallets (QRIS etc.)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([invitationId])
}

model Gift {
  id           String   @id @default(uuid())
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  giverName    String
  type         String   @default("cash") // cash | physical | other
  amount       Float?
  currency     String   @default("USD")
  notes        String?
  thankYouSent Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([invitationId])
}

// ─────────────────────────── Collaborators / Co-hosts ───────────────────────────

model Collaborator {
  id           String   @id @default(uuid())
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  email        String
  userId       String? // linked once the invited email registers/signs in
  user         User?    @relation(fields: [userId], references: [id])
  role         String   @default("editor") // editor | viewer
  status       String   @default("pending") // pending | accepted
  createdAt    DateTime @default(now())

  @@unique([invitationId, email])
  @@index([email])
}
